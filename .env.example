# .env.example — 新環境セットアップ用のキー一覧(/dev-secure #22 が生成)
#
# 使い方: このファイルを .env.local にコピーして値を埋める。
#   cp .env.example .env.local
# 値の出所: Supabase ダッシュボード(Settings > API Keys)と Vercel の環境変数。
# ⚠️ 実値は絶対にコミットしない(.env* は gitignore 済み)。
# ⚠️ 値の行にインラインコメントを付けないこと(パーサが値の一部として取り込む
#    トラップ防止 — 旧 .env.local.example から引き継いだ規律)。
# ⚠️ secret 系(SUPABASE_SECRET_KEY / IP_HASH_SALT / ADMIN_*)に NEXT_PUBLIC を
#    付けない(付けるとクライアントバンドルに埋め込まれ漏えいする)。
# 補足: プレースホルダ値を書かない(値は全て空欄)のは意図的 — `sb_secret_xxx` の
#    ようなプロバイダ形状のダミー値は secret スキャナ(Gitleaks/Trivy/GitHub)の
#    誤検知源になる(Codex ゲート指摘。旧 .env.local.example を置換した理由)。

# --- Supabase(必須。地図表示・API 全般が依存) ---
# プロジェクト URL(https://<project-ref>.supabase.co 形式)
NEXT_PUBLIC_SUPABASE_URL=
# publishable key(新形式 sb_publishable_*。旧 anon key。ブラウザ公開可、RLS が守る)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# secret key(新形式 sb_secret_*。旧 service_role。書き込み API ルート専用・server-only)
SUPABASE_SECRET_KEY=

# --- レビュー/申請のレート制限(任意 — 未設定でも動くが本番は設定推奨) ---
# IP ハッシュ用ソルト(十分に長いランダム文字列。変更すると既存 ip_hash と不整合になる)
IP_HASH_SALT=

# --- /admin 管理画面(両方未設定だと /admin はフェイルクローズ = 誰も入れない) ---
# 共有パスワード。constant-time 比較される。十分に長くランダムに。
ADMIN_PASSWORD=
# 署名 cookie(HMAC-SHA256)の鍵。ローテーションすると全セッション一括失効。
ADMIN_SESSION_SECRET=

# --- feedback-platform (feedback-adcd2)。手順: feedback-platform/docs/CONNECT.md ---
# Web 公開 config。projectId は必ず feedback-adcd2。ホストの Firebase に相乗りしない。
NEXT_PUBLIC_FEEDBACK_FIREBASE_API_KEY=
NEXT_PUBLIC_FEEDBACK_FIREBASE_AUTH_DOMAIN=feedback-adcd2.firebaseapp.com
NEXT_PUBLIC_FEEDBACK_FIREBASE_PROJECT_ID=feedback-adcd2
NEXT_PUBLIC_FEEDBACK_FIREBASE_APP_ID=
NEXT_PUBLIC_FEEDBACK_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FEEDBACK_FIREBASE_STORAGE_BUCKET=feedback-adcd2.firebasestorage.app
# Production のみ prod。未設定 / Preview は feedback_dev。本番受信箱へ書くときだけ prod。
NEXT_PUBLIC_FEEDBACK_TARGET=

# --- AI 提案キュー(/api/admin/analyze。任意 — 未設定なら AI 分析機能のみ無効) ---
# Google AI Studio の API キー(@ai-sdk/google が参照)
GOOGLE_GENERATIVE_AI_API_KEY=
